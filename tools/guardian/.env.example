# QA Guardian Feishu callback service — environment variables.
# Copy to `.env` (gitignored) for local `docker compose`, or paste these into Dokploy's env panel.
# NEVER commit real values. If a secret ever leaked, rotate it before using.

# Feishu self-built app event-subscription credentials (Feishu Open Platform):
FEISHU_VERIFICATION_TOKEN=from-feishu-event-subscription
FEISHU_ENCRYPT_KEY=from-feishu-event-subscription

# GitHub fine-grained PAT scoped to the ONE repo, Issues: read+write only.
GITHUB_TOKEN=github_pat_xxx_fine_grained_issues_rw_only
# owner/name of the repo whose issues receive the /guardian comments.
GITHUB_REPO=LambdaTheory/tuantuanrent

# Optional server tuning (defaults shown):
PORT=8787
CALLBACK_PATH=/feishu/callback
MAX_BODY_BYTES=65536
